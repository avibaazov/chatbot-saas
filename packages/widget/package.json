{
  "name": "@chatbot/widget",
  "version": "0.1.0",
  "private": true,
  "description": "Embeddable chat widget. Ships as a single <script> tag, no runtime deps.",
  "scripts": {
    "build": "esbuild src/widget.ts --bundle --minify --format=iife --outfile=dist/widget.js",
    "dev": "esbuild src/widget.ts --bundle --format=iife --outfile=dist/widget.js --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
