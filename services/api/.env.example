# Copy to .env and fill in. .env is git-ignored — never commit real values.

ENVIRONMENT=development
API_BASE_URL=http://127.0.0.1:8002
CORS_ORIGINS=["http://localhost:3000"]

# Filesystem path to the built widget bundle, served at GET /widget.js. Defaults to the
# monorepo build output (packages/widget/dist/widget.js). Leave unset for local dev; set
# it only if you deploy just services/api and copy the bundle somewhere else.
# WIDGET_BUNDLE_PATH=/app/widget.js

# true: ingestion is awaited inside the create/reload request (response carries a final
# status). Set false behind a host with request timeouts — ingestion then runs as a
# background task and the request returns immediately with status=pending.
INGEST_INLINE=true

# MongoDB Atlas connection string. Get this from the Atlas dashboard for YOUR cluster.
MONGODB_URI=
MONGODB_DB_NAME=chatbot

# Filled in when we build background jobs (AGENTS.md §5 step 4)
REDIS_URL=

# RAG inference (AGENTS.md §5 step 5). Empty => FakeLLMProvider (dev/test only).
ANTHROPIC_API_KEY=

# Embeddings for ingestion + retrieval. Empty => FakeEmbeddingsProvider (dev/test only,
# retrieval quality is meaningless on fake vectors).
VOYAGE_API_KEY=

# DEV ONLY — let URL ingestion fetch 127.0.0.1 / private hosts so you can ingest a demo
# site running locally. Leave false/unset anywhere real; it disables the SSRF guard.
INGEST_ALLOW_PRIVATE_HOSTS=false

# Clerk JWKS URL — from your Clerk app's frontend API domain (decode the base64 in your
# publishable key, e.g. pk_test_<base64>$ -> <domain>), then append /.well-known/jwks.json
CLERK_JWKS_URL=
